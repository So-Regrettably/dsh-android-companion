#!/usr/bin/env python3
"""paint —— 云端画图（智谱 CogView，中文提示词直接支持）

用法：
    paint "蓝发女仆少女，蓝色大眼睛，鲸鱼尾巴，动漫风，全身"
    paint --avatar "..."            # 生成后圆形裁剪成头像
    paint --tall "..."              # 竖版 768x1344（全身立绘用，推荐）
    paint --square "..."            # 方形 1024x1024
    paint --flash "..."             # 用免费的 cogview-3-flash（细节弱一些）
    paint --size 1024x1024 "..."    # 自定义尺寸

默认模型 cogview-4（细节强，尾巴/质感画得出来；按张计费）。
加 --flash 换回免费的 cogview-3-flash。

输出 /root/paint-out/<时间戳>.jpg
API key 放在 /root/.dsh/zhipu_key.conf（一行）。
"""
import sys, os, time, json, urllib.request

OUT_DIR = "/root/paint-out"
os.makedirs(OUT_DIR, exist_ok=True)
KEY_FILE = "/root/.dsh/zhipu_key.conf"
API = "https://open.bigmodel.cn/api/paas/v4/images/generations"

args = sys.argv[1:]
avatar = False
size = "1024x1024"
model = "cogview-4"
rest = []
i = 0
while i < len(args):
    a = args[i]
    if a == "--avatar":
        avatar = True
    elif a == "--flash":
        model = "cogview-3-flash"
    elif a == "--model" and i + 1 < len(args):
        model = args[i + 1]
        i += 1
    elif a == "--tall":
        size = "768x1344"
    elif a == "--square":
        size = "1024x1024"
    elif a == "--size" and i + 1 < len(args):
        size = args[i + 1]
        i += 1
    else:
        rest.append(a)
    i += 1

prompt = " ".join(rest).strip()
if not prompt:
    print('用法: paint "中文描述"   （可加 --avatar / --tall / --size 宽x高）')
    sys.exit(2)

try:
    with open(KEY_FILE) as f:
        key = f.read().strip()
except OSError:
    print("缺 key：请把智谱 API key 写到 %s" % KEY_FILE)
    sys.exit(3)
if not key:
    print("key 文件是空的：%s" % KEY_FILE)
    sys.exit(3)

payload = json.dumps({"model": model, "prompt": prompt, "size": size}).encode("utf-8")

path = None
for attempt in range(3):
    try:
        req = urllib.request.Request(API, data=payload, headers={
            "Authorization": "Bearer " + key,
            "Content-Type": "application/json",
        }, method="POST")
        with urllib.request.urlopen(req, timeout=120) as r:
            j = json.loads(r.read().decode("utf-8", "replace"))
        items = j.get("data") or []
        if not items:
            print("接口返回异常：%s" % json.dumps(j, ensure_ascii=False)[:300])
            time.sleep(5)
            continue
        img_url = items[0].get("url") or ""
        if not img_url:
            print("没拿到图片地址")
            continue
        with urllib.request.urlopen(img_url, timeout=90) as r2:
            data = r2.read()
        if data[:3] == b"\xff\xd8\xff":
            ext = ".jpg"
        elif data[:4] == b"\x89PNG":
            ext = ".png"
        elif data[:4] == b"RIFF":
            ext = ".webp"
        else:
            print("下载的不是图片：%d 字节" % len(data))
            continue
        path = os.path.join(OUT_DIR, time.strftime("%Y%m%d-%H%M%S") + ext)
        with open(path, "wb") as f:
            f.write(data)
        print("OK %s (%d bytes)" % (path, len(data)))
        break
    except Exception as e:
        print("请求失败（第 %d 次）：%s" % (attempt + 1, e))
        time.sleep(6)

if not path:
    print("失败：多次重试仍未生成")
    sys.exit(1)

if avatar:
    try:
        from PIL import Image, ImageDraw
        im = Image.open(path).convert("RGBA")
        w, h = im.size
        s = min(w, h)
        im = im.crop(((w - s) // 2, (h - s) // 2, (w + s) // 2, (h + s) // 2))
        mask = Image.new("L", (s, s), 0)
        ImageDraw.Draw(mask).ellipse((0, 0, s, s), fill=255)
        out = Image.new("RGBA", (s, s), (0, 0, 0, 0))
        out.paste(im, (0, 0), mask)
        ap = os.path.splitext(path)[0] + "-avatar.png"
        out.save(ap)
        print("头像已裁圆：%s" % ap)
        path = ap
    except ImportError:
        print("（没装 Pillow，跳过圆形裁剪）")
    except Exception as e:
        print("裁剪失败：%s" % e)

print("PATH=%s" % path)
