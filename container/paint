#!/usr/bin/env python3
"""paint —— 画图（默认走 Civitai 官方「大肥鱼」LoRA，中文描述自动翻译）

用法：
    paint "坐在电脑前摸鱼，桌上摆着一大碗白米饭"        # 场景图
    paint --scene "满脸委屈地端着白饭碗"               # 同上，显式
    paint "站在窗边看雨"  --tall                       # 竖版立绘（默认）
    paint --square "对着镜头得意地笑"                   # 方图
    paint --avatar "头像，开心地眨眼"                   # 正方形 + 圆形裁剪
    paint --wide "躺在地板上摆烂"                       # 横图
    paint --zhipu "随便画个可爱少女"                    # 退回智谱（不依赖代理）
    paint --flash "..."                                # 智谱免费版

输出：/root/paint-out/<时间戳>.jpg   （成功后打印 OK <路径>）

依赖：本地 mihomo 代理 127.0.0.1:7897（只给本脚本用，不影响系统网络）
配置：/root/.dsh/civitai_key.conf（Civitai API key）、/root/.dsh/zhipu_key.conf（备用）
"""

import base64
import json
import os
import re
import sys
import time
import urllib.parse
import urllib.request

OUT_DIR = "/root/paint-out"
PROXY = "http://127.0.0.1:7897"
CIVITAI_KEY = "/root/.dsh/civitai_key.conf"
ZHIPU_KEY = "/root/.dsh/zhipu_key.conf"

CKPT = "urn:air:sdxl:checkpoint:civitai:795765@889818"          # Illustrious-XL
LORA = "urn:air:sdxl:lora:civitai:2697171@3218534"              # 大肥鱼 IllustriousXL v1.0

CHAR = ("deepseek_whale_girl, deepseek_maid_outfit, 1girl, solo, blue eyes, "
        "very long wavy gradient blue hair, bangs, ahoge, whale fin ears, "
        "white frilled maid headdress, navy blue maid dress, white frilled apron, "
        "blue whale emblem, dark blue neck bow, blue gemstone brooch, puff sleeves, "
        "long sleeves, gold trim, blue whale tail, starry tail pattern, "
        "white thighhighs, black mary janes")

NEG = "worst quality, low quality, blurry, bad anatomy, extra digits, watermark, text"

SIZES = {"tall": (832, 1216), "square": (1024, 1024), "wide": (1216, 832)}


def has_cjk(s):
    return any("\u4e00" <= ch <= "\u9fff" for ch in s)


def translate(text):
    """中文 -> 英文（MyMemory 免费接口）"""
    if not has_cjk(text):
        return text
    try:
        url = ("https://api.mymemory.translated.net/get?q="
               + urllib.parse.quote(text) + "&langpair=zh-CN|en")
        with urllib.request.urlopen(url, timeout=20) as r:
            j = json.loads(r.read().decode("utf-8", "replace"))
        out = (j.get("responseData") or {}).get("translatedText") or ""
        return out.strip() or text
    except Exception:
        return text


def opener(use_proxy=True):
    if use_proxy:
        h = urllib.request.ProxyHandler({"http": PROXY, "https": PROXY})
    else:
        h = urllib.request.ProxyHandler({})
    return urllib.request.build_opener(h)


def read_conf(path):
    try:
        return open(path, encoding="utf-8").read().strip()
    except Exception:
        return ""


def gen_civitai(prompt, w, h, seed=None):
    key = read_conf(CIVITAI_KEY)
    if not key:
        raise RuntimeError("没有 Civitai key")
    body = {
        "steps": [{
            "$type": "imageGen",
            "input": {
                "engine": "sdcpp",
                "ecosystem": "sdxl",
                "operation": "createImage",
                "model": CKPT,
                "prompt": prompt,
                "negativePrompt": NEG,
                "width": w, "height": h,
                "cfgScale": 7,
                "steps": 28,
                "quantity": 1,
                "loras": {LORA: 1.0},
            },
        }]
    }
    if seed:
        body["steps"][0]["input"]["seed"] = int(seed)
    req = urllib.request.Request(
        "https://orchestration.civitai.com/v2/consumer/workflows?wait=90",
        data=json.dumps(body).encode("utf-8"),
        headers={"Authorization": "Bearer " + key, "Content-Type": "application/json"},
        method="POST")
    with opener(True).open(req, timeout=180) as r:
        j = json.loads(r.read().decode("utf-8", "replace"))
    if j.get("status") != "succeeded":
        raise RuntimeError("生成失败：%s" % json.dumps(j.get("errors") or j)[:200])
    imgs = ((j.get("steps") or [{}])[0].get("output") or {}).get("images") or []
    if not imgs:
        raise RuntimeError("没有返回图片")
    url = imgs[0].get("url") or imgs[0].get("previewUrl")
    with opener(True).open(url, timeout=120) as r:
        return r.read()


def gen_zhipu(prompt, w, h, flash=False):
    key = read_conf(ZHIPU_KEY)
    if not key:
        raise RuntimeError("没有智谱 key")
    model = "cogview-3-flash" if flash else "cogview-4"
    size = "%dx%d" % (w, h)
    body = json.dumps({"model": model, "prompt": prompt, "size": size}).encode()
    req = urllib.request.Request(
        "https://open.bigmodel.cn/api/paas/v4/images/generations",
        data=body,
        headers={"Authorization": "Bearer " + key, "Content-Type": "application/json"},
        method="POST")
    with opener(False).open(req, timeout=120) as r:
        j = json.loads(r.read().decode("utf-8", "replace"))
    url = j["data"][0]["url"]
    with opener(False).open(url, timeout=120) as r:
        return r.read()


def circle_crop(path):
    try:
        from PIL import Image, ImageDraw
        im = Image.open(path).convert("RGBA")
        s = min(im.size)
        im = im.crop(((im.width - s) // 2, (im.height - s) // 2,
                      (im.width + s) // 2, (im.height + s) // 2))
        mask = Image.new("L", (s, s), 0)
        ImageDraw.Draw(mask).ellipse((0, 0, s, s), fill=255)
        im.putalpha(mask)
        im.save(path)
        return True
    except Exception as e:
        print("圆形裁剪跳过：%s" % e)
        return False


def main():
    args = sys.argv[1:]
    avatar = False
    scene = None
    size = SIZES["tall"]
    engine = "civitai"
    flash = False
    seed = None
    words = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--avatar":
            avatar, size = True, SIZES["square"]
        elif a == "--square":
            size = SIZES["square"]
        elif a == "--tall":
            size = SIZES["tall"]
        elif a == "--wide":
            size = SIZES["wide"]
        elif a == "--size" and i + 1 < len(args):
            w, h = args[i + 1].lower().split("x")
            size = (int(w), int(h))
            i += 1
        elif a == "--scene" and i + 1 < len(args):
            scene = args[i + 1]
            i += 1
        elif a == "--zhipu":
            engine = "zhipu"
        elif a == "--flash":
            engine, flash = "zhipu", True
        elif a == "--seed" and i + 1 < len(args):
            seed = args[i + 1]
            i += 1
        else:
            words.append(a)
        i += 1

    text = scene or " ".join(words).strip()
    if not text and engine != "civitai":
        print("用法：paint \"中文描述\" [--tall|--square|--wide|--avatar]")
        return 1

    if engine == "civitai":
        en = translate(text) if text else ""
        if en:
            prompt = CHAR + ", " + en + ", masterpiece, best quality"
        else:
            prompt = CHAR + ", full body, standing, white background, masterpiece, best quality"
    else:
        prompt = text

    os.makedirs(OUT_DIR, exist_ok=True)
    ts = time.strftime("%Y%m%d-%H%M%S")
    data, used = None, engine

    if engine == "civitai":
        try:
            print("用官方大肥鱼 LoRA 画（约 4 Buzz）…")
            data = gen_civitai(prompt, size[0], size[1], seed)
        except Exception as e:
            print("Civitai 失败（%s），改用智谱兜底…" % str(e)[:120])
            used = "zhipu-fallback"
            data = gen_zhipu(prompt if not has_cjk(prompt) else text, size[0], size[1])
    else:
        data = gen_zhipu(prompt, size[0], size[1], flash)

    ext = ".png" if data[:4] == b"\x89PNG" else ".jpg"
    path = os.path.join(OUT_DIR, ts + ext)
    with open(path, "wb") as f:
        f.write(data)

    if avatar:
        circle_crop(path)

    print("OK %s (%d bytes, %s)" % (path, len(data), used))
    print("PROMPT %s" % prompt)
    return 0


if __name__ == "__main__":
    sys.exit(main())
